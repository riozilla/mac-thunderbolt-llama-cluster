# Copy to .env and fill in for your own cluster.
# All values are placeholders — no personal infrastructure is baked into the scripts.

# ---- Model ----
# Path to the FIRST shard of a multi-shard GGUF (llama.cpp auto-discovers siblings).
# Do NOT concatenate shards — point at shard 1 with its original name.
MODEL_PATH="$HOME/models/Qwen3-Flash-Next-UD-Q6_K_XL-00001-of-00006.gguf"
MODEL_ALIAS="flash-next"

# ---- Client / head node (runs llama-server) ----
LLAMA_SERVER_HOST="0.0.0.0"
LLAMA_SERVER_PORT="8080"
CONTEXT_SIZE="32768"

# ---- Workers (ggml-rpc-server) ----
# Space-separated list of worker RPC endpoints reachable FROM the head node.
# In the SSH-tunnel setup these are local forwarded ports (see docs/SETUP.md).
WORKER_ENDPOINTS="127.0.0.1:50052 127.0.0.1:50053"

# Per-worker RPC server settings
WORKER_RPC_PORT="50052"
WORKER_DEVICE="MTL0"          # Metal device
WORKER_THREADS="12"

# ---- Transport ----
# TCP is the safe default. RDMA is faster but wedges after dirty teardowns and
# deadlocks on multi-hop topologies — only enable on a direct-link star. See docs.
USE_RDMA="0"                  # 0 = TCP (GGML_RPC_NO_RDMA=1), 1 = RDMA
RDMA_DEVICE=""               # e.g. a Thunderbolt interface, only if USE_RDMA=1

# ---- llama.cpp location ----
LLAMA_CPP_DIR="$HOME/llama.cpp"
